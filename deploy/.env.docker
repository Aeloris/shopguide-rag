# compose 用的 Postgres 默认账号（未显式传 env 时回落这些值；与下面 DATABASE_URL 对齐）
POSTGRES_USER=shopguide
POSTGRES_PASSWORD=shopguide_dev
POSTGRES_DB=shopguide

# 应用侧连接串（运行时 export 到环境 / 或写进仓库根 .env）
# DATABASE_URL=postgresql://shopguide:shopguide_dev@localhost:5432/shopguide
# REDIS_URL=redis://localhost:6379/0
# QDRANT_URL=http://localhost:6333
